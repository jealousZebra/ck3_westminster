# Button on the left edge
widget = {
	name = "wm_polls_opener"
	parentanchor = left|vcenter
	position = { 8 70 }
	size = { 56 56 }
	layer = middle
	visible = "[GetPlayer.IsValid]"
	button = {
		size = { 56 56 }
		texture = "gfx/interface/skinned/hud_maintab/maintab_situations.dds"
		onclick = "[GetScriptedGui('wm_ui_polls_toggle').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		tooltip = "WM_UI_POLLS_TT"
		background = { using = Background_Frame }
	}
}

